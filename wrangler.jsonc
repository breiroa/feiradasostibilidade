{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feiradasostibilidade",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Dominio propio (a zona está na mesma conta de Cloudflare). workers.dev segue activo e redirixe ao dominio.
  "routes": [
    { "pattern": "feiradasostibilidade.com", "custom_domain": true },
    { "pattern": "www.feiradasostibilidade.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "feira",
      // Base de datos D1 en Cloudflare (rexión Europa occidental)
      "database_id": "068dd575-3e21-42c9-b746-7ef4ffac8c3a",
      "migrations_dir": "migrations"
    }
  ]
}
