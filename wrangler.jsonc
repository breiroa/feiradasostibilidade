{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feiradasostibilidade",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "feira",
      // Base de datos D1 en Cloudflare (rexión Europa occidental)
      "database_id": "068dd575-3e21-42c9-b746-7ef4ffac8c3a",
      "migrations_dir": "migrations"
    }
  ]
}
