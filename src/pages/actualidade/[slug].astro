---
import { getCollection, getEntry, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { dataLonga, url } from '../../lib/url';

export async function getStaticPaths() {
  const noticias = await getCollection('noticias', ({ data }) => !data.borrador);
  return noticias.map((noticia) => ({ params: { slug: noticia.id }, props: { noticia } }));
}

const { noticia } = Astro.props;
const d = noticia.data;
const { Content } = await render(noticia);
const edicion = d.edicion ? await getEntry(d.edicion) : undefined;
const imaxeSocial = d.imaxe ? (await getImage({ src: d.imaxe, width: 1200 })).src : undefined;
---

<Base titulo={d.titulo} descricion={d.resumo} imaxe={imaxeSocial}>
  <article class="seccion seccion--branca">
    <div class="contedor artigo">
      <p class="volver"><a href={url('actualidade/')}>← Actualidade</a></p>
      <p class="meta">
        <time datetime={d.data.toISOString().slice(0, 10)}>{dataLonga(d.data)}</time>
        {edicion && <> · <a href={url(`edicions/${edicion.id}/`)}>{edicion.data.titulo}</a></>}
      </p>
      <h1>{d.titulo}</h1>
      <p class="resumo">{d.resumo}</p>
      {d.imaxe && <Image src={d.imaxe} alt={d.imaxeAlt ?? ''} widths={[600, 900, 1300]} sizes="(max-width: 900px) 100vw, 860px" class="foto" loading="eager" />}
      <div class="texto-longo">
        <Content />
      </div>
    </div>
  </article>
</Base>

<style>
  .artigo { max-width: 860px; }
  .volver { margin-bottom: 1.5rem; font-size: 0.9rem; }
  .volver a { text-decoration: none; }
  .meta { font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--texto-suave); margin-bottom: 1rem; }
  h1 { font-size: clamp(2rem, 4.5vw, 3.4rem); margin-bottom: 1.2rem; }
  .resumo { font-family: var(--serif); font-size: clamp(1.15rem, 1.8vw, 1.4rem); line-height: 1.45; color: var(--texto); margin-bottom: 2rem; }
  .foto { width: 100%; border-radius: var(--raio); margin-bottom: 2.2rem; max-height: 620px; object-fit: cover; }
</style>
