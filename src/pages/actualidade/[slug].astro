---
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import { edicion, noticia } from '../../lib/datos';
import { dataTexto, url } from '../../lib/url';

const d = await noticia(Astro.params.slug ?? '');
if (!d) return new Response(null, { status: 404 });
const ed = d.edicion ? await edicion(d.edicion) : null;
---

<Base titulo={d.titulo} descricion={d.resumo} imaxe={d.imaxe}>
  <article class="seccion seccion--branca">
    <div class="contedor artigo">
      <p class="volver"><a href={url('actualidade/')}>← Actualidade</a></p>
      <p class="meta">
        <time datetime={d.data}>{dataTexto(d.data)}</time>
        {ed && <> · <a href={url(`edicions/${ed.id}/`)}>{ed.titulo}</a></>}
      </p>
      <h1>{d.titulo}</h1>
      <p class="resumo">{d.resumo}</p>
      {d.imaxe && <Img id={d.imaxe} alt={d.imaxeAlt ?? ''} sizes="(max-width: 900px) 100vw, 860px" class="foto" loading="eager" />}
      <div class="texto-longo"><Fragment set:html={d.corpo} /></div>
    </div>
  </article>
</Base>

<style>
  .artigo { max-width: 860px; }
  .volver { margin-bottom: 1.5rem; font-size: 0.9rem; }
  .volver a { text-decoration: none; }
  .meta { font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--texto-suave); margin-bottom: 1rem; }
  h1 { font-size: clamp(2rem, 4.5vw, 3.4rem); margin-bottom: 1.2rem; }
  .resumo { font-family: var(--serif); font-size: clamp(1.15rem, 1.8vw, 1.4rem); line-height: 1.45; color: var(--texto); margin-bottom: 2rem; }
  .artigo :global(.foto) { width: 100%; border-radius: var(--raio); margin-bottom: 2.2rem; max-height: 620px; object-fit: cover; }
</style>
