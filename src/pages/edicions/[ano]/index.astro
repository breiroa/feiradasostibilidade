---
import Base from '../../../layouts/Base.astro';
import Hero from '../../../components/Hero.astro';
import StatsBar from '../../../components/StatsBar.astro';
import Programme from '../../../components/Programme.astro';
import Gallery from '../../../components/Gallery.astro';
import LogoGrid from '../../../components/LogoGrid.astro';
import NewsCard from '../../../components/NewsCard.astro';
import ProjectBanner from '../../../components/ProjectBanner.astro';
import { edicion, edicions, mapaEntidades, noticias, proxecto as obterProxecto, resolverEntidades } from '../../../lib/datos';
import { mediaUrl, romano, url } from '../../../lib/url';

const d = await edicion(Astro.params.ano ?? '');
if (!d) return new Response(null, { status: 404 });

const [mapa, todas, nots, proxecto] = await Promise.all([
  mapaEntidades(),
  edicions(),
  noticias(),
  d.proxecto ? obterProxecto(d.proxecto) : Promise.resolve(null),
]);
const grupos = d.grupos.map((g) => ({ ...g, items: resolverEntidades(g.entidades, mapa) })).filter((g) => g.items.length > 0);
const noticiasEd = nots.filter((n) => n.edicion === d.id);
const orde = [...todas].sort((a, b) => a.ano - b.ano);
const pos = orde.findIndex((e) => e.id === d.id);
const anterior = orde[pos - 1];
const seguinte = orde[pos + 1];
---

<Base titulo={d.titulo} descricion={d.resumo} imaxe={d.portada}>
  <Hero etiqueta={`${romano(d.numero)} edición · ${d.ano}`} imaxe={d.portada} imaxeAlt={d.portadaAlt}>
    <h1>{d.titulo}{d.lema && <em class="lema">{d.lema}</em>}</h1>
    <p class="entrada"><strong>{d.datas}</strong><br />{d.lugar}</p>
    {
      d.estado === 'proxima' && (
        <div class="accions">
          {proxecto && <a class="boton" href={url(`edicions/${d.id}/${proxecto.id}/`)}>Proxecto {proxecto.nomeCurto}</a>}
          <a class="boton boton--contorno" href={url('participa/')}>Participa na Feira</a>
        </div>
      )
    }
  </Hero>

  <section class="seccion seccion--branca">
    <div class="contedor presentacion">
      <div class="texto-longo">
        <p class="etiqueta">A edición</p>
        <p class="resumo">{d.resumo}</p>
        <Fragment set:html={d.corpo} />
        {
          d.fitos.length > 0 && (
            <ul class="chips">
              {d.fitos.map((f) => <li class="chip">{f}</li>)}
            </ul>
          )
        }
      </div>
      {d.cifras.length > 0 && <StatsBar cifras={d.cifras} />}
    </div>
  </section>

  {
    proxecto && (
      <section class="seccion">
        <div class="contedor">
          <ProjectBanner proxecto={proxecto} entidades={resolverEntidades(proxecto.entidades, mapa)} />
        </div>
      </section>
    )
  }

  {
    d.programa.length > 0 && (
      <section class="seccion seccion--branca">
        <div class="contedor estreito">
          <p class="etiqueta">Programa</p>
          <h2>Que haberá na Feira.</h2>
          <Programme programa={d.programa} />
        </div>
      </section>
    )
  }

  {
    d.galeria.length > 0 && (
      <section class="seccion">
        <div class="contedor">
          <p class="etiqueta">Galería</p>
          <h2 class="marxe">Imaxes da edición.</h2>
          <Gallery imaxes={d.galeria} />
        </div>
      </section>
    )
  }

  {
    d.videos.length > 0 && (
      <section class="seccion seccion--branca">
        <div class="contedor">
          <p class="etiqueta">Vídeos</p>
          <ul class="grella lista-simple">
            {d.videos.map((v) => (
              <li class="tarxeta video">
                <a class="ligazon-frecha" href={v.url} rel="noopener">{v.titulo}</a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    (d.centros.length > 0 || grupos.length > 0) && (
      <section class="seccion seccion--verde">
        <div class="contedor">
          <p class="etiqueta">Quen participa</p>
          <h2 class="marxe">Centros e entidades.</h2>
          {grupos.map((g) => (
            <div class="bloque">
              <h3>{g.titulo}</h3>
              <LogoGrid entidades={g.items} />
            </div>
          ))}
          {d.centros.length > 0 && (
            <div class="bloque">
              <h3>Centros educativos</h3>
              <ul class="centros">
                {d.centros.map((c) => <li>{c}</li>)}
              </ul>
            </div>
          )}
        </div>
      </section>
    )
  }

  {
    (d.documentos.length > 0 || d.prensa.length > 0) && (
      <section class="seccion seccion--branca">
        <div class="contedor documentos">
          {d.documentos.length > 0 && (
            <div>
              <p class="etiqueta">Documentos</p>
              <ul class="lista-simple">
                {d.documentos.map((doc) => {
                  const destino = doc.ficheiro ? mediaUrl(doc.ficheiro, 'f') : doc.url;
                  return destino ? (
                    <li><a class="ligazon-frecha" href={destino} rel="noopener">{doc.titulo}</a></li>
                  ) : (
                    <li class="pendente">{doc.titulo} <span>· dispoñible en breve</span></li>
                  );
                })}
              </ul>
            </div>
          )}
          {d.prensa.length > 0 && (
            <div>
              <p class="etiqueta">Na prensa</p>
              <ul class="lista-simple">
                {d.prensa.map((pr) => (
                  <li>
                    {pr.url ? <a href={pr.url} rel="noopener">{pr.medio}{pr.titulo && `: ${pr.titulo}`}</a> : <>{pr.medio}{pr.titulo && `: ${pr.titulo}`}</>}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>
    )
  }

  {
    noticiasEd.length > 0 && (
      <section class="seccion">
        <div class="contedor">
          <p class="etiqueta">Actualidade</p>
          <h2 class="marxe">Noticias desta edición.</h2>
          <div class="grella">
            {noticiasEd.map((n) => <NewsCard noticia={n} />)}
          </div>
        </div>
      </section>
    )
  }

  <nav class="contedor navegacion-edicions" aria-label="Outras edicións">
    {anterior ? <a href={url(`edicions/${anterior.id}/`)}>← {anterior.titulo}</a> : <span></span>}
    {seguinte && <a href={url(`edicions/${seguinte.id}/`)}>{seguinte.titulo} →</a>}
  </nav>
</Base>

<style>
  .lema { display: block; font-size: 0.62em; margin-top: 0.4rem; }
  .presentacion { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .resumo { font-family: var(--serif); font-size: clamp(1.25rem, 2vw, 1.55rem); line-height: 1.4; color: var(--texto); }
  .presentacion .chips { margin-top: 1.8rem; }
  .estreito { max-width: 860px; }
  .estreito h2, .marxe { margin-bottom: 2rem; }
  .bloque + .bloque { margin-top: 2.2rem; }
  .bloque h3 { font-size: 1.1rem; margin-bottom: 1rem; }
  .centros { columns: 3 220px; padding-left: 1.2em; }
  .centros li { break-inside: avoid; padding-block: 0.2rem; }
  .lista-simple { list-style: none; padding: 0; display: grid; gap: 0.6rem; }
  .video { padding: 1.2rem; }
  .documentos { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 2.5rem; }
  .pendente { color: var(--texto); }
  .pendente span { color: var(--texto-suave); font-style: italic; }
  .navegacion-edicions { display: flex; justify-content: space-between; gap: 1rem; padding-block: 2.5rem; font-weight: 600; flex-wrap: wrap; }
  .navegacion-edicions a { text-decoration: none; }
  @media (max-width: 860px) { .presentacion { grid-template-columns: 1fr; } }
</style>
