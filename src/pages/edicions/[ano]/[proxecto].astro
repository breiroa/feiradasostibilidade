---
import Base from '../../../layouts/Base.astro';
import Hero from '../../../components/Hero.astro';
import StatsBar from '../../../components/StatsBar.astro';
import ActivityList from '../../../components/ActivityList.astro';
import LogoGrid from '../../../components/LogoGrid.astro';
import NewsCard from '../../../components/NewsCard.astro';
import { edicion, mapaEntidades, noticias, proxecto, resolverEntidades } from '../../../lib/datos';
import { url } from '../../../lib/url';

const p = await proxecto(Astro.params.proxecto ?? '');
if (!p || p.edicion !== Astro.params.ano) return new Response(null, { status: 404 });

const [ed, mapa, nots] = await Promise.all([edicion(p.edicion), mapaEntidades(), noticias()]);
const entidades = resolverEntidades(p.entidades, mapa);
const noticiasEd = nots.filter((n) => n.edicion === p.edicion).slice(0, 6);
---

<Base titulo={p.nomeCurto} descricion={p.resumo}>
  <Hero etiqueta={`Feira ${p.edicion} · Proxecto`} compacto>
    <p class="volver"><a href={url(`edicions/${p.edicion}/`)}>← {ed?.titulo ?? 'Edición'}</a></p>
    <h1>{p.nomeCurto}.{p.subtitulo && <em> {p.subtitulo}</em>}</h1>
    <p class="entrada">{p.titulo.includes(':') ? p.titulo.split(':').slice(1).join(':').trim() : p.titulo}</p>
    {p.cifras.length > 0 && <div slot="baixo" class="contedor"><StatsBar escuro cifras={p.cifras} /></div>}
  </Hero>

  <section class="seccion seccion--branca">
    <div class="contedor duas">
      <div class="texto-longo">
        <p class="etiqueta">O proxecto</p>
        <p class="resumo">{p.resumo}</p>
        <Fragment set:html={p.corpo} />
      </div>
      <aside class="financiamento">
        <p class="etiqueta">Promoven e financian</p>
        <LogoGrid entidades={entidades} />
        <p>{p.financiamento}</p>
      </aside>
    </div>
  </section>

  {
    p.actividades.length > 0 && (
      <section class="seccion">
        <div class="contedor">
          <div class="cabeceira-seccion">
            <div>
              <p class="etiqueta">Actividades</p>
              <h2>Investigar, contrastar, actuar.</h2>
              <p>As actividades organízanse en tres resultados e converxen na Feira. O seu estado actualízase ao longo do curso.</p>
            </div>
          </div>
          <ActivityList actividades={p.actividades} />
        </div>
      </section>
    )
  }

  {
    noticiasEd.length > 0 && (
      <section class="seccion seccion--branca">
        <div class="contedor">
          <p class="etiqueta">Actualidade</p>
          <h2 class="marxe">Diario do proxecto.</h2>
          <div class="grella">
            {noticiasEd.map((n) => <NewsCard noticia={n} />)}
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  .volver { margin-bottom: 1.2rem; font-size: 0.9rem; }
  .volver a { color: var(--verde-medio); text-decoration: none; }
  .duas { display: grid; grid-template-columns: 1.5fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .resumo { font-family: var(--serif); font-size: clamp(1.2rem, 1.9vw, 1.45rem); line-height: 1.4; color: var(--texto); }
  .financiamento { display: grid; gap: 1.2rem; padding: 1.6rem; background: var(--gris-pale); border-radius: var(--raio); font-size: 0.9rem; }
  .marxe { margin-bottom: 2rem; }
  @media (max-width: 860px) { .duas { grid-template-columns: 1fr; } }
</style>
