---
// Páxinas libres soltas (/enderezo/): aviso legal, privacidade, cookies, outras creadas no panel.
import PaxinaLibre from '../components/PaxinaLibre.astro';
import { paxinaLibre } from '../lib/datos';

const id = Astro.params.slug ?? '';
const p = id === 'feiralab' ? null : await paxinaLibre(id);
if (!p || p.nai !== '') return new Response(null, { status: 404 });
---

<PaxinaLibre p={p} />
