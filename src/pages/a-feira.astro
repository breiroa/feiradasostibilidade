---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Img from '../components/Img.astro';
import LogoGrid from '../components/LogoGrid.astro';
import { axustes, mapaEntidades, paxina, resolverEntidades } from '../lib/datos';

interface AFeira {
  heroEtiqueta?: string; heroTitulo?: string; heroDestaque?: string; heroTexto?: string; heroImaxe?: string; heroImaxeAlt?: string;
  introTitulo?: string; introCorpo?: string; introImaxe?: string; introImaxeAlt?: string;
  metodoloxiasTitulo?: string; metodoloxias?: { sigla: string; nome: string; lema: string; texto: string }[];
  linhasTitulo?: string; linhasTexto?: string; linhas?: { titulo: string; texto: string; ods?: string }[];
  premiosTitulo?: string; premios?: { ano: string; texto: string }[];
}

const [p, ax, mapa] = await Promise.all([paxina<AFeira>('a-feira'), axustes(), mapaEntidades()]);
// "Quen a fai posible": os mesmos grupos que o pé
const grupos = ax.pe.grupos.map((g) => ({ ...g, items: resolverEntidades(g.entidades, mapa) })).filter((g) => g.items.length);
---

<Base titulo="A Feira" descricion="Que é a Feira da Sostibilidade: un laboratorio educativo permanente do IES Luís Seoane, impulsado por CIDEL Galicia e a Universidade de Vigo.">
  <Hero etiqueta={p.heroEtiqueta} imaxe={p.heroImaxe} imaxeAlt={p.heroImaxeAlt}>
    <h1>{p.heroTitulo} {p.heroDestaque && <em>{p.heroDestaque}</em>}</h1>
    {p.heroTexto && <p class="entrada">{p.heroTexto}</p>}
  </Hero>

  <section class="seccion seccion--branca">
    <div class="contedor duas">
      <div class="texto-longo">
        <p class="etiqueta">O movemento</p>
        <h2>{p.introTitulo}</h2>
        <Fragment set:html={p.introCorpo ?? ''} />
      </div>
      {p.introImaxe && <Img id={p.introImaxe} alt={p.introImaxeAlt ?? ''} sizes="(max-width: 860px) 100vw, 40vw" class="foto" />}
    </div>
  </section>

  {
    p.metodoloxias?.length ? (
      <section class="seccion seccion--verde">
        <div class="contedor">
          <div class="cabeceira-seccion">
            <div>
              <p class="etiqueta">Como traballamos</p>
              <h2>{p.metodoloxiasTitulo}</h2>
            </div>
          </div>
          <div class="grella">
            {p.metodoloxias.map((m) => (
              <article class="tarxeta metodo">
                <span class="sigla">{m.sigla}</span>
                <p class="etiqueta">{m.nome}</p>
                <h3>{m.lema}</h3>
                <p>{m.texto}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    ) : null
  }

  {
    p.linhas?.length ? (
      <section class="seccion seccion--branca">
        <div class="contedor">
          <div class="cabeceira-seccion">
            <div>
              <p class="etiqueta">Liñas de traballo</p>
              <h2>{p.linhasTitulo}</h2>
              {p.linhasTexto && <p>{p.linhasTexto}</p>}
            </div>
          </div>
          <ol class="linhas">
            {p.linhas.map((l, i) => (
              <li>
                <span class="n">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{l.titulo}</h3>
                  <p>{l.texto}</p>
                  {l.ods && <p class="ods">{l.ods}</p>}
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>
    ) : null
  }

  {
    p.premios?.length ? (
      <section class="seccion seccion--escura">
        <div class="contedor">
          <p class="etiqueta">Recoñecementos</p>
          <h2 class="marxe">{p.premiosTitulo}</h2>
          <ul class="premios">
            {p.premios.map((pr) => (
              <li>
                <span>{pr.ano}</span>
                <p>{pr.texto}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ) : null
  }

  {
    grupos.length > 0 && (
      <section class="seccion">
        <div class="contedor">
          <p class="etiqueta">Quen a fai posible</p>
          <h2 class="marxe">Un instituto, dúas entidades que o impulsan.</h2>
          <div class="grupos">
            {grupos.map((g) => (
              <div>
                <h3>{g.titulo}</h3>
                <LogoGrid entidades={g.items} />
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  .duas { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .duas :global(.foto) { width: 100%; border-radius: var(--raio); aspect-ratio: 4 / 3; object-fit: cover; }
  .metodo { padding: 1.8rem; gap: 0.6rem; position: relative; }
  .sigla { font-family: var(--serif); font-size: 3rem; font-weight: 900; color: var(--verde-suave); line-height: 1; }
  .metodo p:last-child { font-size: 0.95rem; }
  .linhas { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 0 3rem; }
  .linhas li { display: flex; gap: 1.2rem; padding-block: 1.6rem; border-top: 1px solid var(--linha); }
  .n { font-family: var(--mono); color: var(--morado); font-size: 0.9rem; padding-top: 0.2rem; }
  .linhas h3 { margin-bottom: 0.4rem; }
  .linhas p { font-size: 0.95rem; }
  .ods { font-family: var(--mono); font-size: 0.72rem !important; color: var(--verde); margin-top: 0.5rem; letter-spacing: 0.06em; }
  .marxe { margin-bottom: 2rem; }
  .premios { list-style: none; padding: 0; display: grid; gap: 1.2rem; }
  .premios li { display: grid; grid-template-columns: 9rem 1fr; gap: 1.5rem; padding-top: 1.2rem; border-top: 1px solid rgb(255 255 255 / 0.12); }
  .premios span { font-family: var(--mono); color: var(--verde-medio); font-size: 0.85rem; }
  .premios p { color: var(--branco); font-size: 1.1rem; }
  .grupos { display: flex; flex-wrap: wrap; gap: 2rem 3rem; }
  .grupos h3 { font-size: 1.05rem; margin-bottom: 0.9rem; }
  @media (max-width: 860px) {
    .duas { grid-template-columns: 1fr; }
    .premios li { grid-template-columns: 1fr; gap: 0.3rem; }
  }
</style>
