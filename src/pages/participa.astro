---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { site } from '../data/site';
import { url } from '../lib/url';

const perfis = [
  {
    titulo: 'Centros educativos',
    texto: 'Trae á Feira os proxectos do teu alumnado: stands, obradoiros, xogos, exposicións ou microcharlas. Os centros participantes en SENDA 2030 contan con acompañamento durante o curso.',
  },
  {
    titulo: 'Entidades e colectivos',
    texto: 'Asociacións, ONGD, cooperativas e iniciativas do territorio poden organizar un stand, un obradoiro ou participar nas charlas-foro e no Foro de Desenvolvemento Local.',
  },
  {
    titulo: 'Empresas e administracións',
    texto: 'Colabora coa Feira achegando recursos, experiencias ou espazos de diálogo arredor da sostibilidade e a economía local.',
  },
  {
    titulo: 'Prensa e medios',
    texto: 'Información, imaxes e contactos para a cobertura da Feira e dos proxectos do alumnado.',
  },
];
---

<Base titulo="Participa" descricion="Como participar na Feira da Sostibilidade: centros educativos, entidades, empresas e medios.">
  <Hero etiqueta="Participa" compacto>
    <h1>Non veñas só mirar. <em>Participa.</em></h1>
    <p class="entrada">A Feira constrúese entre moitas mans. Estas son as formas de formar parte da V edición, os días 28, 29 e 30 de abril de 2027.</p>
  </Hero>

  <section class="seccion">
    <div class="contedor grella">
      {
        perfis.map((p) => (
          <article class="tarxeta perfil">
            <h2>{p.titulo}</h2>
            <p>{p.texto}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="seccion seccion--branca">
    <div class="contedor contacto">
      <div>
        <p class="etiqueta">Contacto</p>
        <h2>Falamos?</h2>
        <p>Mentres preparamos os formularios de inscrición da V edición, escríbenos por Instagram ou a través do IES Luís Seoane.</p>
      </div>
      <div class="accions">
        <a class="boton" href={site.instagram} rel="noopener">Instagram {site.instagramUsuario}</a>
        {site.correo && <a class="boton boton--contorno" href={`mailto:${site.correo}`}>{site.correo}</a>}
        <a class="boton boton--contorno" href={site.webIes} rel="noopener">IES Luís Seoane</a>
      </div>
    </div>
  </section>

  <section class="seccion seccion--morada">
    <div class="contedor">
      <p class="etiqueta">Rede de Ciencia Cidadá</p>
      <h2 class="marxe">O teu centro quere investigar?</h2>
      <p class="texto-longo">
        A Feira forma parte dunha rede máis ampla de centros que fan ciencia cidadá coa Universidade de Vigo. Coñece o proxecto <a href={url('edicions/2027/senda-2030/')}>SENDA 2030</a> e as súas actividades para centros e profesorado.
      </p>
    </div>
  </section>
</Base>

<style>
  .perfil { padding: 1.8rem; gap: 0.7rem; }
  .perfil h2 { font-size: 1.4rem; }
  .perfil p { font-size: 0.97rem; }
  .contacto { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 2rem; }
  .contacto p:not(.etiqueta) { max-width: 52ch; margin-top: 0.8rem; }
  .accions { display: flex; flex-wrap: wrap; gap: 0.8rem; }
  .marxe { margin-bottom: 1rem; }
</style>
