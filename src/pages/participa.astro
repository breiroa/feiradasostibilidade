---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { axustes, paxina } from '../lib/datos';
import { formularios } from '../lib/formularios';
import { url } from '../lib/url';

interface Participa {
  heroTitulo?: string; heroDestaque?: string; heroTexto?: string;
  datas?: { data: string; texto: string }[];
  perfis?: { id: string; titulo: string; texto: string; accions?: string[]; boton?: string }[];
  formularioTitulo?: string; formularioTexto?: string;
  graciasTitulo?: string; graciasTexto?: string;
}

const [p, ax] = await Promise.all([paxina<Participa>('participa'), axustes()]);
const q = Astro.url.searchParams;
const enviado = q.get('enviado');
const erro = q.get('erro');
const mensaxeErro = erro === 'privacidade' ? 'Para enviar o formulario tes que aceptar a política de privacidade.' : erro === 'datos' ? 'Non puidemos ler o formulario. Proba de novo.' : erro;
// Que formulario se abre: o do erro, ou o que se escolleu desde un perfil (?tipo=)
const perfilFormulario: Record<string, string> = { centro: 'centro', entidade: 'entidade', empresa: 'entidade', prensa: 'prensa' };
const activo = q.get('tipo') ?? 'centro';
---

<Base titulo="Participa" descricion="Como participar na Feira da Sostibilidade: centros educativos, entidades, empresas, administracións e medios.">
  <Hero etiqueta="Participa" compacto>
    <h1>{p.heroTitulo} {p.heroDestaque && <em>{p.heroDestaque}</em>}</h1>
    {p.heroTexto && <p class="entrada">{p.heroTexto}</p>}
    {
      p.datas?.length ? (
        <ul class="datas">
          {p.datas.map((d) => (
            <li>
              <strong>{d.data}</strong>
              <span>{d.texto}</span>
            </li>
          ))}
        </ul>
      ) : null
    }
  </Hero>

  <section class="seccion">
    <div class="contedor">
      <div class="cabeceira-seccion">
        <div>
          <p class="etiqueta">Como podes participar</p>
          <h2>Atopa o teu sitio na Feira.</h2>
        </div>
      </div>
      <div class="perfis">
        {
          p.perfis?.map((pf) => (
            <article class="tarxeta perfil">
              <h3>{pf.titulo}</h3>
              <p>{pf.texto}</p>
              {pf.accions?.length ? (
                <ul class="accions-lista">
                  {pf.accions.map((a) => <li>{a}</li>)}
                </ul>
              ) : null}
              <a class="boton" href={`${url('participa/')}?tipo=${perfilFormulario[pf.id] ?? 'contacto'}#formulario`} data-abrir={perfilFormulario[pf.id] ?? 'contacto'}>
                {pf.boton ?? 'Participar'}
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="seccion seccion--branca" id="formulario">
    <div class="contedor formulario-grella">
      <div class="intro">
        <p class="etiqueta">Formulario</p>
        <h2>{p.formularioTitulo}</h2>
        {p.formularioTexto && <p>{p.formularioTexto}</p>}
        <p class="outras">
          Tamén podes escribirnos por {ax.instagram ? <a href={ax.instagram} rel="noopener">Instagram</a> : 'Instagram'}{ax.correo && <> ou a <a href={`mailto:${ax.correo}`}>{ax.correo}</a></>}.
        </p>
      </div>

      <div class="caixa">
        {
          enviado ? (
            <div class="aviso aviso--ok" role="status">
              <h3>{p.graciasTitulo}</h3>
              <p>{p.graciasTexto}</p>
              <a href={`${url('participa/')}#formulario`}>Enviar outra mensaxe</a>
            </div>
          ) : (
            <>
              {mensaxeErro && <div class="aviso aviso--erro" role="alert">{mensaxeErro}</div>}
              <div class="pestanas" role="tablist" aria-label="Tipo de participación">
                {formularios.map((f) => (
                  <button type="button" role="tab" id={`pestana-${f.id}`} aria-controls={`form-${f.id}`} aria-selected={String(f.id === activo)} data-tipo={f.id}>
                    {f.titulo.split(',')[0]}
                  </button>
                ))}
              </div>
              {formularios.map((f) => (
                <form id={`form-${f.id}`} role="tabpanel" aria-labelledby={`pestana-${f.id}`} method="post" action={url('api/participa')} hidden={f.id !== activo} class="formulario">
                  <input type="hidden" name="tipo" value={f.id} />
                  <div class="trampa" aria-hidden="true">
                    <label>Non encher<input type="text" name="web_alternativa" tabindex="-1" autocomplete="off" /></label>
                  </div>
                  <div class="campos">
                    {f.campos.map((c) => {
                      const idc = `${f.id}-${c.nome}`;
                      return (
                        <div class:list={['campo', { ancho: c.ancho || c.tipo === 'area' }]}>
                          <label for={idc}>
                            {c.etiqueta}
                            {c.obrigatorio && <span class="obrig" aria-hidden="true"> *</span>}
                          </label>
                          {c.tipo === 'area' ? (
                            <textarea id={idc} name={c.nome} rows="4" maxlength={c.max} required={c.obrigatorio} />
                          ) : c.tipo === 'opcion' ? (
                            <select id={idc} name={c.nome} required={c.obrigatorio}>
                              <option value="">Escolle…</option>
                              {c.opcions?.map((o) => <option>{o}</option>)}
                            </select>
                          ) : (
                            <input
                              id={idc}
                              name={c.nome}
                              type={c.tipo === 'numero' ? 'number' : c.tipo === 'texto' ? 'text' : c.tipo}
                              maxlength={c.tipo === 'numero' ? undefined : c.max}
                              min={c.tipo === 'numero' ? 0 : undefined}
                              required={c.obrigatorio}
                              autocomplete={c.tipo === 'email' ? 'email' : c.tipo === 'tel' ? 'tel' : undefined}
                            />
                          )}
                        </div>
                      );
                    })}
                  </div>
                  <label class="privacidade">
                    <input type="checkbox" name="privacidade" value="si" required />
                    <span>
                      Acepto que os meus datos se usen só para organizar a participación na Feira (<a href={url('aviso-legal/')}>privacidade</a>).
                    </span>
                  </label>
                  <button class="boton" type="submit">Enviar</button>
                  <p class="nota">* Campos obrigatorios</p>
                </form>
              ))}
            </>
          )
        }
      </div>
    </div>
  </section>
</Base>

<script>
  const pestanas = document.querySelectorAll<HTMLButtonElement>('[role="tab"]');
  const abrir = (tipo: string) => {
    pestanas.forEach((t) => {
      const si = t.dataset.tipo === tipo;
      t.setAttribute('aria-selected', String(si));
      const panel = document.getElementById(`form-${t.dataset.tipo}`);
      if (panel) panel.hidden = !si;
    });
  };
  pestanas.forEach((t) => t.addEventListener('click', () => abrir(t.dataset.tipo ?? 'centro')));
  // Os botóns dos perfís abren directamente o formulario axeitado
  document.querySelectorAll<HTMLAnchorElement>('[data-abrir]').forEach((a) =>
    a.addEventListener('click', (e) => {
      if (!pestanas.length) return;
      e.preventDefault();
      abrir(a.dataset.abrir ?? 'centro');
      document.getElementById('formulario')?.scrollIntoView({ behavior: 'smooth' });
    }),
  );
</script>

<style>
  .datas { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 2rem; }
  .datas li { display: grid; gap: 0.15rem; padding: 0.8rem 1.1rem; border: 1px solid rgb(255 255 255 / 0.15); border-radius: var(--raio); background: rgb(0 0 0 / 0.2); }
  .datas strong { font-family: var(--mono); font-size: 0.8rem; letter-spacing: 0.06em; color: var(--verde-medio); text-transform: uppercase; }
  .datas span { color: var(--branco); font-size: 0.95rem; }

  .perfis { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); }
  .perfil { padding: 1.7rem; gap: 0.9rem; }
  .perfil h3 { font-size: 1.35rem; }
  .perfil > p { font-size: 0.97rem; }
  .accions-lista { padding: 0; list-style: none; display: grid; gap: 0.45rem; font-size: 0.93rem; color: var(--texto); }
  .accions-lista li { padding-left: 1.4rem; position: relative; }
  .accions-lista li::before { content: '→'; position: absolute; left: 0; color: var(--verde); }
  .perfil .boton { margin-top: auto; justify-content: center; }

  .formulario-grella { display: grid; grid-template-columns: 0.8fr 1.4fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .intro h2 { margin-bottom: 1rem; }
  .outras { margin-top: 1.2rem; font-size: 0.95rem; }
  .caixa { background: var(--gris-pale); border: 1px solid var(--linha); border-radius: var(--raio); padding: clamp(1.25rem, 3vw, 2rem); }
  .pestanas { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1.5rem; }
  .pestanas button {
    font: inherit; font-size: 0.88rem; cursor: pointer; padding: 0.5rem 1rem; border-radius: 99px;
    border: 1px solid var(--linha); background: var(--branco); color: var(--texto-medio);
  }
  .pestanas button[aria-selected='true'] { background: var(--negro); border-color: var(--negro); color: var(--branco); }
  .campos { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem 1.2rem; }
  .campo { display: grid; gap: 0.35rem; }
  .campo.ancho { grid-column: 1 / -1; }
  .campo label { font-size: 0.88rem; font-weight: 600; color: var(--texto); }
  .obrig { color: var(--morado); }
  .campo :is(input, select, textarea) {
    font: inherit; font-size: 0.97rem; padding: 0.65rem 0.8rem; border: 1px solid #cfc9da; border-radius: var(--raio);
    background: var(--branco); color: var(--texto); width: 100%;
  }
  .campo :is(input, select, textarea):focus { outline: 3px solid var(--morado-suave); border-color: var(--morado); }
  .privacidade { display: flex; gap: 0.6rem; align-items: flex-start; margin-block: 1.4rem 1.2rem; font-size: 0.9rem; }
  .privacidade input { margin-top: 0.3rem; width: 1.05rem; height: 1.05rem; accent-color: var(--verde); }
  .nota { font-size: 0.8rem; color: var(--texto-suave); margin-top: 0.8rem; }
  .trampa { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .aviso { padding: 1rem 1.2rem; border-radius: var(--raio); margin-bottom: 1.2rem; }
  .aviso--erro { background: #fdecea; border: 1px solid #f3b8b0; color: #8a2a1d; }
  .aviso--ok { background: var(--verde-pale); border: 1px solid var(--verde-suave); color: var(--texto); display: grid; gap: 0.6rem; }
  .aviso--ok h3 { color: var(--verde-escuro); }
  @media (max-width: 860px) {
    .formulario-grella { grid-template-columns: 1fr; }
    .campos { grid-template-columns: 1fr; }
  }
</style>
