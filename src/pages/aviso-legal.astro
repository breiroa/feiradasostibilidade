---
import Base from '../layouts/Base.astro';
import { paxina } from '../lib/datos';

const p = await paxina<{ corpo?: string }>('aviso-legal');
---

<Base titulo="Aviso legal e privacidade">
  <section class="seccion seccion--branca">
    <div class="contedor texto-longo">
      <p class="etiqueta">Aviso legal</p>
      <h1>Aviso legal e privacidade</h1>
      <Fragment set:html={p.corpo ?? ''} />
    </div>
  </section>
</Base>

<style>
  h1 { font-size: clamp(2rem, 4vw, 3rem); }
</style>
