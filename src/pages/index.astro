---
import Base from '../layouts/Base.astro';
import Seccions from '../components/seccions/Seccions.astro';
import { paxina, seccionsValidas } from '../lib/datos';

const seccions = seccionsValidas((await paxina<{ seccions?: unknown }>('inicio')).seccions);
const heroe = seccions.find((s) => s.tipo === 'heroe');
---

<Base imaxe={heroe && 'imaxe' in heroe ? heroe.imaxe : undefined}>
  <Seccions seccions={seccions} />
</Base>
