---
import PaxinaLibre from '../components/PaxinaLibre.astro';
import { paxina, paxinaSistema, seccionsValidas } from '../lib/datos';

const p = await paxinaSistema('inicio');
// Mentres non se migre, a portada segue lendo o documento antigo (paxinas/inicio)
if (!p.seccions.length) p.seccions = seccionsValidas((await paxina<{ seccions?: unknown }>('inicio')).seccions);
---

<PaxinaLibre p={p} portada />
