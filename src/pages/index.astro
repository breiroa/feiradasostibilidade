---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import StatsBar from '../components/StatsBar.astro';
import EditionCard from '../components/EditionCard.astro';
import NewsCard from '../components/NewsCard.astro';
import Gallery from '../components/Gallery.astro';
import LogoGrid from '../components/LogoGrid.astro';
import { axustes, edicions, mapaEntidades, noticias, paxina, resolverEntidades } from '../lib/datos';
import { romano, url } from '../lib/url';

interface Inicio {
  heroEtiqueta?: string; heroTitulo?: string; heroDestaque?: string; heroTexto?: string; heroImaxe?: string; heroImaxeAlt?: string;
  cifras?: { valor: string; etiqueta: string }[];
  edicionsTitulo?: string; edicionsTexto?: string;
  cita?: string; citaDestaque?: string;
  ecosistemaTitulo?: string; ecosistemaTexto?: string; ecosistemaEntidades?: string[];
  participaTitulo?: string; participaTexto?: string;
}

const [p, ax, eds, nots, mapa] = await Promise.all([paxina<Inicio>('inicio'), axustes(), edicions(), noticias(), mapaEntidades()]);
const actual = eds.find((e) => e.id === ax.edicionActual);
const ultimaPasada = eds.find((e) => e.estado === 'pasada');
const galeria = ultimaPasada?.galeria.slice(0, 8) ?? [];
const ecosistema = resolverEntidades(p.ecosistemaEntidades ?? [], mapa);
---

<Base>
  <Hero etiqueta={p.heroEtiqueta} imaxe={p.heroImaxe} imaxeAlt={p.heroImaxeAlt}>
    <h1>{p.heroTitulo} {p.heroDestaque && <em>{p.heroDestaque}</em>}</h1>
    {p.heroTexto && <p class="entrada">{p.heroTexto}</p>}
    <div class="accions">
      {actual && <a class="boton" href={url(`edicions/${actual.id}/`)}>{romano(actual.numero)} Feira · {actual.datas.replace(/ de \d{4}$/, '')}</a>}
      <a class="boton boton--contorno" href={url('a-feira/')}>Que é a Feira</a>
    </div>
    {p.cifras?.length ? <div slot="baixo" class="contedor cifras-heroe"><StatsBar escuro cifras={p.cifras} /></div> : null}
  </Hero>

  {
    actual && (
      <section class="seccion seccion--branca">
        <div class="contedor proxima">
          <div>
            <p class="etiqueta">{actual.estado === 'proxima' ? 'Próxima edición' : 'Edición actual'}</p>
            <h2>{actual.titulo}</h2>
            {actual.lema && <p class="lema">{actual.lema}</p>}
            <p class="datas">
              <strong>{actual.datas}</strong>
              <br />
              {actual.lugar}
            </p>
            <p>{actual.resumo}</p>
            {actual.fitos.length > 0 && (
              <ul class="chips">
                {actual.fitos.map((f) => <li class="chip">{f}</li>)}
              </ul>
            )}
            <a class="boton" href={url(`edicions/${actual.id}/`)}>Ver a {romano(actual.numero)} edición</a>
          </div>
          {actual.cifras.length > 0 && <StatsBar cifras={actual.cifras} />}
        </div>
      </section>
    )
  }

  <section class="seccion">
    <div class="contedor">
      <div class="cabeceira-seccion">
        <div>
          <p class="etiqueta">As edicións</p>
          <h2>{p.edicionsTitulo}</h2>
          {p.edicionsTexto && <p>{p.edicionsTexto}</p>}
        </div>
        <a class="ligazon-frecha" href={url('edicions/')}>Todas as edicións</a>
      </div>
      <div class="grella">
        {eds.map((e) => <EditionCard edicion={e} />)}
      </div>
    </div>
  </section>

  {
    p.cita && (
      <section class="cita">
        <div class="contedor">
          <blockquote>
            <p>
              {p.cita} {p.citaDestaque && <span>{p.citaDestaque}</span>}
            </p>
          </blockquote>
        </div>
      </section>
    )
  }

  {
    nots.length > 0 && (
      <section class="seccion seccion--branca">
        <div class="contedor">
          <div class="cabeceira-seccion">
            <div>
              <p class="etiqueta">Actualidade</p>
              <h2>O proceso en directo.</h2>
            </div>
            <a class="ligazon-frecha" href={url('actualidade/')}>Todas as noticias</a>
          </div>
          <div class="grella">
            {nots.slice(0, 3).map((n) => <NewsCard noticia={n} />)}
          </div>
        </div>
      </section>
    )
  }

  {
    galeria.length > 0 && ultimaPasada && (
      <section class="seccion">
        <div class="contedor">
          <div class="cabeceira-seccion">
            <div>
              <p class="etiqueta">{ultimaPasada.titulo}</p>
              <h2>Así foi a última Feira.</h2>
            </div>
            <a class="ligazon-frecha" href={url(`edicions/${ultimaPasada.id}/`)}>Ver a edición {ultimaPasada.ano}</a>
          </div>
          <Gallery imaxes={galeria} />
        </div>
      </section>
    )
  }

  {
    ecosistema.length > 0 && (
      <section class="seccion seccion--verde">
        <div class="contedor">
          <div class="cabeceira-seccion">
            <div>
              <p class="etiqueta">O ecosistema</p>
              <h2>{p.ecosistemaTitulo}</h2>
              {p.ecosistemaTexto && <p>{p.ecosistemaTexto}</p>}
            </div>
          </div>
          <LogoGrid entidades={ecosistema} />
        </div>
      </section>
    )
  }

  <section class="seccion bloque-participa">
    <div class="contedor participa">
      <div>
        <p class="etiqueta">Participa</p>
        <h2>{p.participaTitulo}</h2>
        {p.participaTexto && <p>{p.participaTexto}</p>}
      </div>
      <div class="accions">
        <a class="boton" href={url('participa/')}>Como participar</a>
        {ax.instagram && <a class="boton boton--contorno" href={ax.instagram} rel="noopener">{ax.instagramUsuario ?? 'Instagram'}</a>}
      </div>
    </div>
  </section>
</Base>

<style>
  .cifras-heroe { position: relative; padding-bottom: 0; }
  .proxima { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .proxima h2 { margin-bottom: 0.4rem; }
  .lema { font-family: var(--serif); font-style: italic; font-size: 1.35rem; color: var(--morado); margin-bottom: 1.2rem; }
  .datas { margin-bottom: 1rem; color: var(--texto); }
  .proxima .chips { margin-block: 1.4rem 2rem; }
  .cita { background: var(--verde); padding-block: clamp(2.5rem, 6vw, 4rem); }
  blockquote p { font-family: var(--serif); font-style: italic; font-size: clamp(1.6rem, 3.4vw, 2.6rem); line-height: 1.25; color: var(--branco); }
  blockquote span { color: var(--negro); font-style: normal; }
  .bloque-participa { background: var(--morado); color: rgb(255 255 255 / 0.85); }
  .bloque-participa h2 { color: var(--branco); }
  .bloque-participa .etiqueta { color: var(--morado-suave); }
  .bloque-participa .boton { background: var(--branco); border-color: var(--branco); color: var(--morado); }
  .bloque-participa .boton:hover { background: var(--morado-pale); border-color: var(--morado-pale); color: var(--negro); }
  .bloque-participa .boton--contorno { background: transparent; color: var(--branco); border-color: rgb(255 255 255 / 0.5); }
  .bloque-participa .boton--contorno:hover { background: transparent; color: var(--branco); border-color: var(--branco); }
  .participa { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 2rem; }
  .participa p:not(.etiqueta) { max-width: 52ch; margin-top: 0.8rem; }
  .accions { display: flex; flex-wrap: wrap; gap: 0.8rem; }
  @media (max-width: 860px) { .proxima { grid-template-columns: 1fr; } }
</style>
