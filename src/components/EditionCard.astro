---
import type { Edicion } from '../lib/esquemas';
import Img from './Img.astro';
import { romano, url } from '../lib/url';

interface Props {
  edicion: Edicion;
}

const { edicion: d } = Astro.props;
const proxima = d.estado === 'proxima';
---

<article class:list={['tarxeta', 'edicion', { proxima }]}>
  <a href={url(`edicions/${d.id}/`)} class="ligazon-tarxeta">
    <div class="cuberta">
      {d.portada ? <Img id={d.portada} alt={d.portadaAlt ?? ''} sizes="(max-width: 700px) 100vw, 360px" /> : <div class="sen-foto" aria-hidden="true"><span>{d.ano}</span></div>}
      <span class="numero">{romano(d.numero)}</span>
      {proxima && <span class="estado">Próxima edición</span>}
    </div>
    <div class="corpo">
      <p class="ano">{d.datas}</p>
      <h3>{d.titulo}</h3>
      <p>{d.resumo}</p>
    </div>
  </a>
</article>

<style>
  .edicion { height: 100%; transition: transform 0.2s, box-shadow 0.2s; }
  .edicion:hover { transform: translateY(-4px); box-shadow: 0 2px 4px color-mix(in srgb, var(--negro) 6%, transparent), 0 24px 48px color-mix(in srgb, var(--negro) 14%, transparent); }
  .ligazon-tarxeta { display: flex; flex-direction: column; height: 100%; text-decoration: none; color: inherit; }
  .cuberta { position: relative; aspect-ratio: 16 / 10; background: var(--negro); overflow: hidden; }
  .cuberta :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .sen-foto {
    height: 100%; display: flex; align-items: flex-start; justify-content: flex-end; padding: 1rem 1.2rem;
    background:
      radial-gradient(ellipse 80% 70% at 80% 20%, color-mix(in srgb, var(--verde) 45%, transparent), transparent 60%),
      radial-gradient(ellipse 70% 80% at 10% 90%, color-mix(in srgb, var(--morado) 45%, transparent), transparent 60%),
      var(--negro);
  }
  .sen-foto span { font-family: var(--serif); font-weight: 900; font-size: clamp(3rem, 7vw, 4.6rem); line-height: 1; color: rgb(255 255 255 / 0.14); }
  .numero {
    position: absolute; left: 1rem; bottom: 0.8rem;
    font-family: var(--serif); font-size: 2.6rem; font-weight: 900; line-height: 1; color: var(--branco);
    text-shadow: 0 2px 12px rgb(0 0 0 / 0.5);
  }
  .estado {
    position: absolute; top: 0.9rem; left: 0.9rem;
    font-family: var(--mono); font-size: 0.65rem; letter-spacing: 0.12em; text-transform: uppercase;
    background: var(--verde); color: var(--branco); padding: 0.3rem 0.65rem; border-radius: 99px;
  }
  .corpo { padding: 1.3rem 1.4rem 1.6rem; display: grid; gap: 0.5rem; }
  .ano { font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--verde); }
  .corpo p:last-child { font-size: 0.95rem; }
  .proxima { box-shadow: 0 0 0 2px var(--verde), 0 14px 34px color-mix(in srgb, var(--verde) 18%, transparent); }
</style>
