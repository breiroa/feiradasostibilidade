---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  entidades: CollectionEntry<'entidades'>[];
  escuro?: boolean;
}

// Se a entidade aínda non ten logo, móstrase o seu nome nunha tarxeta.
const { entidades, escuro = false } = Astro.props;
---

<ul class:list={['logos', { escuro }]}>
  {
    entidades.map(({ data }) => {
      const contido = data.logo ? (
        <Image src={data.logo} alt={data.nome} height={56} class="logo" />
      ) : (
        <span class="nome">{data.nome}</span>
      );
      return (
        <li>
          {data.web ? (
            <a href={data.web} rel="noopener" title={data.nome}>
              {contido}
            </a>
          ) : (
            <div>{contido}</div>
          )}
        </li>
      );
    })
  }
</ul>

<style>
  .logos { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.75rem; }
  li > * {
    display: grid; place-items: center; min-height: 76px; min-width: 150px; padding: 0.8rem 1.1rem;
    background: var(--branco); border: 1px solid var(--linha); border-radius: var(--raio);
    text-decoration: none; color: var(--texto);
  }
  a:hover { border-color: var(--verde); }
  .logo { height: 48px; width: auto; max-width: 180px; object-fit: contain; }
  .nome { font-weight: 600; font-size: 0.9rem; text-align: center; line-height: 1.25; max-width: 18ch; }
  .escuro li > * { background: var(--branco); border-color: transparent; }
</style>
