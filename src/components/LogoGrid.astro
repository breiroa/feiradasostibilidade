---
// Fila de logos sen caixas: cada logo á mesma altura óptica; se a entidade non ten logo, móstrase o nome con tipografía coidada.
// Sobre fondos escuros os logos van nunha placa clara común (non unha caixa por logo).
import type { Entidade } from '../lib/esquemas';
import { mediaUrl } from '../lib/url';

interface Props {
  entidades: Entidade[];
  tamano?: 'pequeno' | 'normal' | 'grande';
  escuro?: boolean;
}

const { entidades, tamano = 'normal', escuro = false } = Astro.props;
---

<ul class:list={['logos', `logos--${tamano}`, { escuro }]}>
  {
    entidades.map((e) => {
      const contido = e.logo ? <img src={mediaUrl(e.logo, 'g')} alt={e.nome} loading="lazy" decoding="async" /> : <span class="nome">{e.nome}</span>;
      return (
        <li title={e.nome}>
          {e.web ? (
            <a href={e.web} rel="noopener">
              {contido}
            </a>
          ) : (
            contido
          )}
        </li>
      );
    })
  }
</ul>

<style>
  .logos { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 1.4rem 2.6rem; }
  .logos.escuro { background: var(--crema); padding: 1.1rem 1.6rem; border-radius: 14px; }
  li { display: flex; align-items: center; }
  li > a { display: flex; align-items: center; text-decoration: none; border-radius: 6px; }
  img { height: 54px; width: auto; max-width: 290px; object-fit: contain; mix-blend-mode: multiply; transition: transform 0.2s, filter 0.2s; }
  .logos--pequeno img { height: 40px; max-width: 160px; }
  .logos--grande img { height: 70px; max-width: 260px; }
  a:hover img { transform: scale(1.04); }
  .nome {
    font-family: var(--serif); font-weight: 700; font-size: 1.02rem; line-height: 1.15; color: var(--texto);
    max-width: 16ch; padding-left: 0.75rem; border-left: 3px solid var(--verde-suave);
  }
  .logos--pequeno .nome { font-size: 0.92rem; }
  a:hover .nome { color: var(--verde); border-left-color: var(--verde); }
</style>
