---
// Páxina construída con seccións. Se non empeza cunha portada, móstrase unha cabeceira sinxela
// (a «cabeceira» da páxina ou, se non a ten, o título e a descrición).
import type { PaxinaLibre } from '../lib/esquemas';
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import Seccions from './seccions/Seccions.astro';
import { url } from '../lib/url';

interface Props {
  p: PaxinaLibre;
  volver?: { href: string; texto: string };
  portada?: boolean; // a páxina de inicio usa o título xeral da web
}
const { p, volver, portada = false } = Astro.props;
const visibles = p.seccions.filter((s) => !s.oculta);
const conHeroe = visibles[0]?.tipo === 'heroe';
const cab = p.cabeceira;
const heroe = visibles.find((s) => s.tipo === 'heroe');
const imaxeSocial = p.imaxe ?? (heroe && 'imaxe' in heroe ? heroe.imaxe : undefined) ?? cab?.imaxe;
---

<Base titulo={portada ? undefined : p.titulo} descricion={p.descricion} imaxe={imaxeSocial}>
  {
    !conHeroe && (
      <div data-sec="_cabeceira" style="display: contents">
      <Hero etiqueta={cab?.etiqueta} imaxe={cab?.imaxe} imaxeAlt={cab?.imaxeAlt} compacto>
        {volver && <p class="volver"><a href={url(volver.href)}>← {volver.texto}</a></p>}
        <h1>{cab?.titulo ?? p.titulo}{cab?.destaque && <>{' '}<em>{cab.destaque}</em></>}</h1>
        {(cab?.texto ?? p.descricion) && <p class="entrada">{cab?.texto ?? p.descricion}</p>}
        {
          cab?.datas.length ? (
            <ul class="datas">
              {cab.datas.map((d) => (
                <li>
                  <strong>{d.data}</strong>
                  <span>{d.texto}</span>
                </li>
              ))}
            </ul>
          ) : null
        }
      </Hero>
      </div>
    )
  }
  <Seccions seccions={p.seccions} primeiraH1={conHeroe} />
</Base>

<style>
  .volver { margin-bottom: 1rem; font-size: 0.9rem; }
  .volver a { color: var(--verde-medio); text-decoration: none; }
  .datas { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 2rem; }
  .datas li { display: grid; gap: 0.15rem; padding: 0.8rem 1.1rem; border: 1px solid rgb(255 255 255 / 0.15); border-radius: 12px; background: rgb(0 0 0 / 0.2); }
  .datas strong { font-family: var(--mono); font-size: 0.8rem; letter-spacing: 0.06em; color: var(--verde-medio); text-transform: uppercase; }
  .datas span { color: var(--branco); font-size: 0.95rem; }
</style>
