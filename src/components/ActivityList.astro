---
interface Actividade {
  codigo: string;
  resultado: string;
  titulo: string;
  descricion: string;
  estado: 'prevista' | 'en-curso' | 'feita';
}
interface Props {
  actividades: Actividade[];
}

const { actividades } = Astro.props;
const estados = { prevista: 'Prevista', 'en-curso': 'En curso', feita: 'Feita' };
// Agrupa respectando a orde do ficheiro
const grupos = [...new Set(actividades.map((a) => a.resultado))].map((r) => ({
  resultado: r,
  items: actividades.filter((a) => a.resultado === r),
}));
---

<div class="grupos">
  {
    grupos.map((g) => (
      <section>
        <h3>{g.resultado}</h3>
        <ul class="grella">
          {g.items.map((a) => (
            <li class="tarxeta actividade">
              <div class="cabeza">
                <span class="codigo">{a.codigo}</span>
                <span class:list={['estado', a.estado]}>{estados[a.estado]}</span>
              </div>
              <h4>{a.titulo}</h4>
              <p>{a.descricion}</p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .grupos { display: grid; gap: 3rem; }
  h3 { margin-bottom: 1.2rem; font-size: 1.3rem; }
  ul { list-style: none; padding: 0; }
  .actividade { padding: 1.3rem 1.4rem 1.5rem; gap: 0.6rem; }
  .cabeza { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .codigo { font-family: var(--mono); font-size: 0.75rem; color: var(--morado); letter-spacing: 0.06em; }
  .estado { font-family: var(--mono); font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.1em; padding: 0.25rem 0.6rem; border-radius: 99px; background: var(--gris-pale); color: var(--texto-suave); border: 1px solid var(--linha); }
  .estado.en-curso { background: var(--morado-pale); color: var(--morado); border-color: var(--morado-suave); }
  .estado.feita { background: var(--verde-pale); color: var(--verde-escuro); border-color: var(--verde-suave); }
  h4 { font-size: 1.1rem; }
  p { font-size: 0.93rem; }
</style>
