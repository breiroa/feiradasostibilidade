---
// Listado completo: todas as noticias (filtro por edición), os recursos (filtro por tipo; pódese limitar a uns tipos
// para facer páxinas de recursos distintas) ou todas as edicións. O filtro é un despregable.
import type { Seccion } from '../../lib/esquemas';
import { edicions, noticias, recursos, tiposRecurso } from '../../lib/datos';
import Envoltorio from './Envoltorio.astro';
import NewsCard from '../NewsCard.astro';
import ResourceCard from '../ResourceCard.astro';
import EditionCard from '../EditionCard.astro';
import { romano } from '../../lib/url';

type T = Extract<Seccion, { tipo: 'listado' }>;
interface Props { s: T }
const { s } = Astro.props;

const nots = s.de === 'noticias' ? await noticias() : [];
const XERAL = '_xeral';
const recs = s.de === 'recursos' ? (await recursos()).filter((r) => !s.tipos.length || s.tipos.includes(r.tipo)) : [];
const tipos = s.de === 'recursos' ? await tiposRecurso() : {};
const eds = s.de === 'edicions' || s.de === 'noticias' ? await edicions() : [];
// Filtro de noticias co mesmo nome curto das edicións que na navegación: «2027 · V Feira»
const nomeEd = (id: string) => { const e = eds.find((x) => x.id === id); return e ? `${e.ano} · ${romano(e.numero)} Feira` : id; };
const opcions =
  s.de === 'noticias'
    ? [
        ...[...new Set(nots.map((n) => n.edicion).filter((e): e is string => Boolean(e)))].sort().reverse().map((e) => ({ valor: e, texto: nomeEd(e) })),
        // Noticias xerais, sen edición
        ...(nots.some((n) => !n.edicion) ? [{ valor: XERAL, texto: 'Outras noticias' }] : []),
      ]
    : s.de === 'recursos'
      ? [...new Set(recs.map((r) => r.tipo))].map((t) => ({ valor: t, texto: tipos[t] ?? t }))
      : [];
const todas = s.de === 'noticias' ? 'Todas as noticias' : 'Todos os recursos';
const etiqueta = 'Filtrar';
const id = `filtro-${s.id}`;
---

<Envoltorio s={s} texto={s.texto}>
  <div data-listado>
    {
      s.filtro && opcions.length > 1 && (
        <div class="filtro">
          <label for={id}>{etiqueta}</label>
          <div class="filtro-caixa">
            <select id={id} data-filtro>
              <option value="">{todas}</option>
              {opcions.map((o) => <option value={o.valor}>{o.texto}</option>)}
            </select>
            <svg aria-hidden="true" width="12" height="12" viewBox="0 0 10 10"><path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
          </div>
          <span class="filtro-conta" aria-live="polite" data-conta></span>
        </div>
      )
    }
    {s.de === 'noticias' && nots.length === 0 && <p>Aínda non hai noticias.</p>}
    {s.de === 'noticias' && <div class="grella">{nots.map((n) => <div data-valor={n.edicion ?? XERAL}><NewsCard edicions={eds} noticia={n} /></div>)}</div>}
    {s.de === 'recursos' && recs.length === 0 && <p>Aínda non hai recursos.</p>}
    {s.de === 'recursos' && <div class="grella-rec">{recs.map((r) => <div data-valor={r.tipo}><ResourceCard recurso={r} tipos={tipos} /></div>)}</div>}
    {s.de === 'edicions' && <div class="grella">{eds.map((e) => <EditionCard edicion={e} />)}</div>}
  </div>
</Envoltorio>

<script>
  document.querySelectorAll<HTMLElement>('[data-listado]').forEach((cont) => {
    const sel = cont.querySelector<HTMLSelectElement>('[data-filtro]');
    const conta = cont.querySelector<HTMLElement>('[data-conta]');
    const items = [...cont.querySelectorAll<HTMLElement>('[data-valor]')];
    if (!sel) return;
    const aplicar = () => {
      const f = sel.value;
      let n = 0;
      items.forEach((i) => {
        i.hidden = Boolean(f) && i.dataset.valor !== f;
        if (!i.hidden) n++;
      });
      if (conta) conta.textContent = f ? `${n} ${n === 1 ? 'resultado' : 'resultados'}` : '';
    };
    sel.addEventListener('change', aplicar);
    aplicar();
  });
</script>

<style>
  .grella-rec { display: grid; gap: clamp(1.1rem, 2.6vw, 1.9rem); grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr)); }
  .filtro { display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap; margin-bottom: 2rem; }
  .filtro label { font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--texto-suave); }
  .filtro-caixa { position: relative; }
  .filtro select {
    appearance: none; font: inherit; font-weight: 600; font-size: 0.95rem; color: var(--texto);
    padding: 0.7rem 2.8rem 0.7rem 1.1rem; min-width: 15rem; border-radius: 99px; cursor: pointer;
    background: var(--branco); border: 1px solid var(--linha); box-shadow: 0 1px 2px color-mix(in srgb, var(--negro) 5%, transparent), 0 6px 18px color-mix(in srgb, var(--negro) 6%, transparent);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .filtro select:hover { border-color: var(--verde); }
  .filtro select:focus-visible { outline: 3px solid var(--verde-suave); border-color: var(--verde); }
  .filtro-caixa svg { position: absolute; right: 1.1rem; top: 50%; transform: translateY(-50%); pointer-events: none; color: var(--verde); }
  .filtro-conta { font-size: 0.88rem; color: var(--texto-suave); }
  :global(.fondo-branco) .filtro select { background: var(--crema); }
</style>
