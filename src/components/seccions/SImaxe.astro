---
// Unha foto grande con pé: ao ancho do texto, ao ancho normal ou a toda a pantalla.
import type { Seccion } from '../../lib/esquemas';
import Envoltorio from './Envoltorio.astro';
import Img from '../Img.astro';

type T = Extract<Seccion, { tipo: 'imaxe' }>;
interface Props { s: T }
const { s } = Astro.props;
const completa = s.tamano === 'completa';
---

{
  completa ? (
    <section class:list={['sec-imaxe-completa', `fondo-${s.fondo}`]} id={s.ancla} data-sec={s.id}>
      {(s.etiqueta || s.titulo) && (
        <div class="contedor cab">
          {s.etiqueta && <p class="etiqueta">{s.etiqueta}</p>}
          {s.titulo && <h2>{s.titulo}</h2>}
        </div>
      )}
      <figure>
        <Img id={s.imaxe} alt={s.alt ?? ''} sizes="100vw" />
        {s.pe && <figcaption class="contedor">{s.pe}</figcaption>}
      </figure>
    </section>
  ) : (
    <Envoltorio s={s} ancho={s.tamano === 'texto' ? 'estreito' : 'normal'}>
      <figure class="foto">
        <Img id={s.imaxe} alt={s.alt ?? ''} sizes={s.tamano === 'texto' ? '(max-width: 900px) 100vw, 900px' : '(max-width: 1240px) 100vw, 1240px'} />
        {s.pe && <figcaption>{s.pe}</figcaption>}
      </figure>
    </Envoltorio>
  )
}

<style>
  figure { margin: 0; }
  .foto :global(img) { width: 100%; border-radius: 20px; display: block; }
  figcaption { margin-top: 0.8rem; font-size: 0.9rem; color: var(--texto-suave); }
  .sec-imaxe-completa .cab { padding-block: clamp(2.5rem, 5vw, 4rem) 1.5rem; }
  .sec-imaxe-completa :global(img) { width: 100%; max-height: 82vh; object-fit: cover; display: block; }
  .sec-imaxe-completa figcaption { padding-block: 0.8rem 1.2rem; }
</style>
