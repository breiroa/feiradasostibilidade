---
// Sección de vídeo (YouTube ou Vimeo, sen cookies ata premer)
import type { Seccion } from '../../lib/esquemas';
import Envoltorio from './Envoltorio.astro';
import Video from '../Video.astro';

type T = Extract<Seccion, { tipo: 'video' }>;
interface Props { s: T }
const { s } = Astro.props;
---

<Envoltorio s={s} texto={s.texto} ancho="estreito">
  <Video url={s.url} />
</Envoltorio>
