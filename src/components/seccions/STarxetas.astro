---
import type { Seccion } from '../../lib/esquemas';
import Envoltorio from './Envoltorio.astro';
import Img from '../Img.astro';
import { ed, edItem, editando } from '../../lib/editable';

type T = Extract<Seccion, { tipo: 'tarxetas' }>;
interface Props { s: T }
const { s } = Astro.props;
const conImaxes = s.items.some((i) => i.imaxe);
const editar = editando(Astro.locals);
const E = (r: string, t: 'texto' | 'area' | 'imaxe' = 'texto', ph?: string) => ed(Astro.locals, r, t, ph);
---

<Envoltorio s={s} texto={s.texto}>
  <ul class:list={['tx', `tx--${s.columnas}`, { 'tx--imaxes': conImaxes }]}>
    {
      s.items.map((it, n) => (
        <li class:list={['tx-item', { 'con-ligazon': it.url }]} {...edItem(Astro.locals, `items.${n}`)} data-url-ruta={editar ? `items.${n}.url` : undefined}>
          {it.imaxe ? (
            <Img id={it.imaxe} alt={it.imaxeAlt ?? ''} sizes="(max-width: 700px) 100vw, 33vw" class="tx-foto" {...E(`items.${n}.imaxe`, 'imaxe')} />
          ) : conImaxes && editar ? (
            <div class="tx-foto previa-sen-imaxe" {...E(`items.${n}.imaxe`, 'imaxe')}>+ Foto</div>
          ) : (
            !conImaxes && s.numerar && <span class="tx-num" aria-hidden="true">{String(n + 1).padStart(2, '0')}</span>
          )}
          <div class="tx-corpo">
            {(it.etiqueta || editar) && <p class="tx-etiqueta" {...E(`items.${n}.etiqueta`, 'texto', 'Etiqueta')}>{it.etiqueta}</p>}
            <h3>{it.url && !editar ? <a href={it.url}>{it.titulo}</a> : <span {...E(`items.${n}.titulo`, 'texto', 'Título')}>{it.titulo}</span>}</h3>
            {(it.texto || editar) && <p {...E(`items.${n}.texto`, 'area', 'Texto')}>{it.texto}</p>}
            {it.url && (it.boton || editar) && <span class="tx-boton ligazon-frecha" aria-hidden="true" {...E(`items.${n}.boton`, 'texto', 'Texto da ligazón')}>{it.boton}</span>}
          </div>
        </li>
      ))
    }
  </ul>
</Envoltorio>

<style>
  .tx { list-style: none; padding: 0; margin: 0; display: grid; gap: clamp(1rem, 2.4vw, 1.6rem); grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); }
  .tx--2 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); }
  .tx--4 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr)); }
  .tx-item {
    position: relative; background: var(--branco); border-radius: 18px; overflow: hidden;
    box-shadow: 0 1px 2px color-mix(in srgb, var(--negro) 5%, transparent), 0 10px 30px color-mix(in srgb, var(--negro) 7%, transparent);
    display: flex; flex-direction: column; transition: transform 0.25s, box-shadow 0.25s;
  }
  .con-ligazon:hover { transform: translateY(-4px); box-shadow: 0 2px 4px color-mix(in srgb, var(--negro) 6%, transparent), 0 22px 44px color-mix(in srgb, var(--negro) 13%, transparent); }
  .tx-item :global(.tx-foto) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; }
  .tx-num { font-family: var(--serif); font-weight: 900; font-size: 2.6rem; line-height: 1; color: var(--verde-suave); padding: 1.6rem 1.6rem 0; }
  .tx-corpo { padding: 1.3rem 1.6rem 1.7rem; display: flex; flex-direction: column; gap: 0.55rem; flex: 1; }
  .tx-boton { margin-top: auto; padding-top: 0.4rem; color: var(--verde); white-space: normal; }
  .tx-etiqueta { font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--morado); }
  .tx-corpo p:not(.tx-etiqueta) { font-size: 0.97rem; }
  h3 a { color: inherit; text-decoration: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; }
  .con-ligazon:hover h3 a { color: var(--verde); }
  :global(.fondo-escuro) .tx-item, :global(.fondo-morado) .tx-item { background: rgb(255 255 255 / 0.06); box-shadow: none; border: 1px solid rgb(255 255 255 / 0.12); }
  :global(.fondo-escuro) .tx-item h3, :global(.fondo-morado) .tx-item h3 { color: var(--branco); }
</style>
