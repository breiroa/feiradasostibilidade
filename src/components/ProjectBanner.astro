---
import type { Entidade, Proxecto } from '../lib/esquemas';
import LogoGrid from './LogoGrid.astro';
import { url } from '../lib/url';

interface Props {
  proxecto: Proxecto;
  entidades: Entidade[];
}

// Bloque destacado que enlaza dende a edición á subpáxina do proxecto (ex. SENDA 2030).
const { proxecto: p, entidades } = Astro.props;
---

<aside class="banner">
  <div class="texto">
    <p class="etiqueta">Proxecto vinculado a esta edición</p>
    <h2>{p.nomeCurto}.{p.subtitulo && <em> {p.subtitulo}</em>}</h2>
    <p>{p.resumo}</p>
    <p class="financia">{p.financiamento}</p>
    <a class="boton" href={url(`edicions/${p.edicion}/${p.id}/`)}>Coñece o proxecto e as súas actividades</a>
  </div>
  <div class="logos">
    <LogoGrid entidades={entidades} />
  </div>
</aside>

<style>
  .banner {
    display: grid; grid-template-columns: 1.3fr 1fr; gap: 2.5rem; align-items: center;
    background: var(--morado-pale); border: 1px solid var(--morado-suave); border-left: 6px solid var(--morado);
    border-radius: var(--raio); padding: clamp(1.5rem, 4vw, 3rem);
  }
  .etiqueta { color: var(--morado); }
  h2 { margin-bottom: 1rem; }
  h2 em { color: var(--morado); }
  .financia { font-size: 0.88rem; color: var(--texto-suave); margin-block: 1rem 1.6rem; }
  @media (max-width: 860px) { .banner { grid-template-columns: 1fr; } }
</style>
