---
import Img from './Img.astro';
import { mediaUrl } from '../lib/url';

interface Props {
  imaxes: { imaxe: string; alt?: string }[];
}

// Miniaturas; ao premer ábrese a foto grande.
const { imaxes } = Astro.props;
---

<ul class="galeria">
  {
    imaxes.map((i) => (
      <li>
        <a href={mediaUrl(i.imaxe, 'g')} target="_blank" rel="noopener">
          <Img id={i.imaxe} alt={i.alt ?? ''} so="m" />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .galeria { list-style: none; padding: 0; display: grid; gap: 0.6rem; grid-template-columns: repeat(auto-fill, minmax(min(46%, 220px), 1fr)); }
  a { display: block; overflow: hidden; border-radius: var(--raio); }
  a :global(img) { width: 100%; aspect-ratio: 1; object-fit: cover; transition: transform 0.4s; }
  a:hover :global(img) { transform: scale(1.04); }
</style>
