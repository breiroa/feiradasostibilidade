---
// Páxina dunha edición (úsase na web e na vista previa do panel)
import type { Edicion } from '../lib/esquemas';
import Base from '../layouts/Base.astro';
import StatsBar from './StatsBar.astro';
import SHeroe from './seccions/SHeroe.astro';
import Seccions from './seccions/Seccions.astro';
import { edicions } from '../lib/datos';
import { romano, url } from '../lib/url';

interface Props { d: Edicion }
const { d } = Astro.props;
const todas = (await edicions()).filter((e) => e.id !== d.id).concat(d).sort((a, b) => a.ano - b.ano);
const pos = todas.findIndex((e) => e.id === d.id);
const anterior = todas[pos - 1];
const seguinte = todas[pos + 1];

// Portada xerada cos datos da edición (título, lema, datas e lugar)
const [titulo, ...resto] = d.titulo.split(' · ');
const heroe = {
  tipo: 'heroe' as const,
  id: 'portada',
  oculta: false,
  fondo: 'escuro' as const,
  etiqueta: `${romano(d.numero)} edición · ${d.datas}`,
  titulo,
  destaque: resto.join(' · ') || d.lema,
  texto: d.lugar,
  imaxe: d.portada,
  imaxeAlt: d.portadaAlt,
  botons:
    d.estado === 'proxima'
      ? [
          ...(d.proxecto ? [{ texto: 'O camiño ata a Feira', url: '#senda-2030', estilo: 'principal' as const }] : []),
          { texto: 'Participa na Feira', url: url('participa/'), estilo: d.proxecto ? ('secundario' as const) : ('principal' as const) },
        ]
      : [],
  cifras: [],
};
---

<Base titulo={d.titulo} descricion={d.resumo} imaxe={d.portada}>
  <div data-sec="_cabeceira" style="display: contents"><SHeroe s={heroe} /></div>

  <section class="sec fondo-branco presentacion-sec" data-sec="_cabeceira">
    <div class="contedor presentacion">
      <div>
        <p class="etiqueta">A edición</p>
        {resto.length > 0 && d.lema && <p class="lema">{d.lema}</p>}
        <p class="resumo">{d.resumo}</p>
        {
          d.fitos.length > 0 && (
            <ul class="chips">
              {d.fitos.map((f) => <li class="chip">{f}</li>)}
            </ul>
          )
        }
      </div>
      {d.cifras.length > 0 && <StatsBar cifras={d.cifras} />}
    </div>
  </section>

  <Seccions seccions={d.seccions} primeiraH1={false} />

  <nav class="contedor navegacion-edicions" aria-label="Outras edicións">
    {anterior ? <a href={url(`edicions/${anterior.id}/`)}>← {anterior.ano} · {romano(anterior.numero)} Feira</a> : <span></span>}
    {seguinte && <a href={url(`edicions/${seguinte.id}/`)}>{seguinte.ano} · {romano(seguinte.numero)} Feira →</a>}
  </nav>
</Base>

<style>
  .presentacion { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .lema { font-family: var(--serif); font-style: italic; font-size: 1.35rem; color: var(--morado); margin-bottom: 0.8rem; }
  .resumo { font-family: var(--serif); font-size: clamp(1.3rem, 2.1vw, 1.7rem); line-height: 1.38; color: var(--texto); }
  .presentacion .chips { margin-top: 1.6rem; }
  .navegacion-edicions { display: flex; justify-content: space-between; gap: 1rem; padding-block: 2.5rem; font-weight: 600; flex-wrap: wrap; }
  .navegacion-edicions a { text-decoration: none; }
  @media (max-width: 860px) { .presentacion { grid-template-columns: 1fr; } }
</style>
