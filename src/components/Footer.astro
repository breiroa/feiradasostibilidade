---
import type { Axustes, Entidade, Estrutura } from '../lib/esquemas';
import { ligazonContacto } from '../lib/contactos';
import LogoGrid from './LogoGrid.astro';
import { resolverEntidades } from '../lib/datos';
import type { LigazonNav } from '../lib/navegacion';
import type { Marca } from '../lib/identidade';
import { ed, edItem, editando } from '../lib/editable';
import Seccions from './seccions/Seccions.astro';

interface Props {
  axustes: Axustes;
  estrutura: Estrutura;
  mapa: Map<string, Entidade>;
  navegacion: LigazonNav[];
  legais: LigazonNav[];
  marca: Marca;
  editable?: boolean; // na vista previa do pé: os seus textos edítanse directamente
}

const { axustes: ax, estrutura: est, mapa, navegacion, legais, marca, editable = false } = Astro.props;
// Na vista previa doutra páxina, o pé vese pero non se edita
const editar = editando(Astro.locals) && editable;
const bloqueado = editando(Astro.locals) && !editable;
const E = (r: string, t: 'texto' | 'area' | 'rico' = 'texto', ph?: string) => (editar ? ed(Astro.locals, r, t, ph) : {});
const I = (r: string) => (editar ? edItem(Astro.locals, r) : {});
const pe = est.pe;
const grupos = pe.grupos.map((g, n) => ({ ...g, n, items: resolverEntidades(g.entidades, mapa) })).filter((g) => g.items.length > 0);
const premios = pe.premios ?? [];
const contactos = (ax.contactos ?? []).map(ligazonContacto).filter((x): x is NonNullable<typeof x> => Boolean(x));
const externa = (h: string) => /^https?:/i.test(h);
---

{
  (est.seccions ?? []).length > 0 && (
    <div class="pe-seccions" data-sen-edicion={bloqueado ? '' : undefined}>
      <Seccions seccions={est.seccions} primeiraH1={false} />
    </div>
  )
}
<footer class="rodape" data-sec={editar ? '_pe' : undefined} data-sec-tipo={editar ? '_pe' : undefined} data-sen-edicion={bloqueado ? '' : undefined}>
  {
    (grupos.length > 0 || premios.length > 0) && (
      <div class="pe-claro">
        <div class="contedor">
          {grupos.length > 0 && (
            <div class="grupos">
              {grupos.map((g) => (
                <section class="grupo" {...I(`pe.grupos.${g.n}`)}>
                  <p class="grupo-titulo" {...E(`pe.grupos.${g.n}.titulo`)}>{g.titulo}</p>
                  <LogoGrid entidades={g.items} />
                  {(g.nota || editar) && <p class="nota" {...E(`pe.grupos.${g.n}.nota`, 'texto', 'Nota (opcional)')}>{g.nota}</p>}
                </section>
              ))}
            </div>
          )}
          {premios.length > 0 && (
            <div class="premios">
              <p class="grupo-titulo">Recoñecementos</p>
              <ul>
                {premios.map((p, n) => (
                  <li {...I(`pe.premios.${n}`)}>
                    <svg class="loureiro" viewBox="0 0 48 48" aria-hidden="true">
                      <path d="M24 40c-7-2-12-8-13-16M24 40c7-2 12-8 13-16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                      <g fill="currentColor">
                        <ellipse cx="10" cy="20" rx="2.6" ry="5" transform="rotate(-20 10 20)" />
                        <ellipse cx="12" cy="29" rx="2.6" ry="5" transform="rotate(-45 12 29)" />
                        <ellipse cx="17" cy="36" rx="2.6" ry="5" transform="rotate(-70 17 36)" />
                        <ellipse cx="38" cy="20" rx="2.6" ry="5" transform="rotate(20 38 20)" />
                        <ellipse cx="36" cy="29" rx="2.6" ry="5" transform="rotate(45 36 29)" />
                        <ellipse cx="31" cy="36" rx="2.6" ry="5" transform="rotate(70 31 36)" />
                      </g>
                      <circle cx="24" cy="21" r="6" fill="currentColor" opacity=".25" />
                    </svg>
                    <span>
                      <b {...E(`pe.premios.${n}.ano`)}>{p.ano}</b>
                      <span {...E(`pe.premios.${n}.texto`, 'area')}>{p.texto}</span>
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    )
  }

  <div class="pe-escuro">
    <div class="contedor columnas">
      <div>
        {pe.mostrarMarca && <p class="nome"><img src={marca.logo} alt="" width="40" height="36" />{marca.antes} <em>{marca.destacado}</em></p>}
        {(pe.texto || editar) && <p {...E('pe.texto', 'area', 'Texto do pé (opcional)')}>{pe.texto}</p>}
      </div>
      <nav aria-label="Pé de páxina">
        <p class="etiqueta" {...E('pe.tituloMenu')}>{pe.tituloMenu}</p>
        <ul>
          {navegacion.map((i) => <li><a href={i.href}>{i.texto}</a></li>)}
        </ul>
      </nav>
      {
        pe.mostrarContactos && contactos.length > 0 && (
          <div>
            <p class="etiqueta" {...E('pe.tituloContactos')}>{pe.tituloContactos}</p>
            <ul>
              {contactos.map((k) => <li><a href={k.href} rel={externa(k.href) ? 'noopener' : undefined}>{k.texto}</a></li>)}
            </ul>
          </div>
        )
      }
    </div>
    <div class="contedor legal">
      {(pe.licenzaCorpo || editar) && <div class="licenza" {...E('pe.licenzaCorpo', 'rico', 'Licenza ou texto legal (opcional)')}><Fragment set:html={pe.licenzaCorpo} /></div>}
      <ul>
        {legais.map((l) => <li><a href={l.href}>{l.texto}</a></li>)}
      </ul>
    </div>
  </div>
</footer>

<style>
  .pe-claro { background: var(--crema); border-top: 1px solid var(--linha); padding-block: clamp(2.5rem, 5vw, 3.5rem); }
  .pe-claro .contedor { display: grid; gap: 2.5rem; }
  .grupos { display: flex; flex-wrap: wrap; gap: 2.2rem 4rem; align-items: flex-start; }
  .grupo { display: grid; gap: 0.9rem; }
  .grupo-titulo { font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--texto-suave); }
  .nota { font-family: var(--mono); font-size: 0.68rem; color: var(--texto-suave); }
  .premios { border-top: 1px solid var(--linha); padding-top: 1.8rem; display: grid; gap: 1rem; }
  .premios ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 1rem 2.5rem; }
  .premios li { display: flex; align-items: center; gap: 0.8rem; max-width: 34rem; color: var(--texto); font-size: 0.95rem; line-height: 1.35; }
  .premios b { display: block; font-family: var(--serif); font-size: 1.05rem; color: var(--verde-escuro); }
  .loureiro { width: 46px; height: 46px; flex: none; color: #b08a2e; }
  .pe-escuro { background: var(--negro); color: rgb(255 255 255 / 0.7); padding-block: 3rem 2rem; font-size: 0.95rem; }
  .pe-escuro a { color: rgb(255 255 255 / 0.85); }
  .pe-escuro a:hover { color: var(--verde-medio); }
  .etiqueta { color: var(--verde-medio); }
  .columnas { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 2rem; padding-bottom: 2.2rem; }
  .columnas ul { list-style: none; padding: 0; display: grid; gap: 0.4rem; }
  .nome { display: flex; align-items: center; gap: 0.6rem; font-family: var(--serif); font-size: 1.4rem; font-weight: 700; color: var(--branco); margin-bottom: 0.8rem; }
  .nome em { color: var(--verde-medio); }
  .legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; padding-top: 1.5rem; border-top: 1px solid rgb(255 255 255 / 0.1); font-size: 0.85rem; }
  .licenza :global(p) { margin: 0; }
  .legal ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.4rem 1.4rem; }
  @media (max-width: 760px) {
    .columnas { grid-template-columns: 1fr; }
  }
</style>
