---
import type { Axustes, Entidade } from '../lib/esquemas';
import LogoGrid from './LogoGrid.astro';
import { resolverEntidades } from '../lib/datos';
import { nav } from '../data/site';
import { url } from '../lib/url';

interface Props {
  axustes: Axustes;
  mapa: Map<string, Entidade>;
}

const { axustes: ax, mapa } = Astro.props;
const grupos = ax.pe.grupos.map((g) => ({ ...g, items: resolverEntidades(g.entidades, mapa) })).filter((g) => g.items.length > 0);
const premios = ax.pe.premios ?? [];
const legais = [
  { href: 'aviso-legal/', texto: 'Aviso legal' },
  { href: 'privacidade/', texto: 'Privacidade' },
  { href: 'cookies/', texto: 'Cookies' },
  { href: 'accesibilidade/', texto: 'Accesibilidade' },
];
---

<footer class="rodape">
  {
    (grupos.length > 0 || premios.length > 0) && (
      <div class="pe-claro">
        <div class="contedor">
          {grupos.length > 0 && (
            <div class="grupos">
              {grupos.map((g) => (
                <section class="grupo">
                  <p class="grupo-titulo">{g.titulo}</p>
                  <LogoGrid entidades={g.items} />
                  {g.nota && <p class="nota">{g.nota}</p>}
                </section>
              ))}
            </div>
          )}
          {premios.length > 0 && (
            <div class="premios">
              <p class="grupo-titulo">Recoñecementos</p>
              <ul>
                {premios.map((p) => (
                  <li>
                    <svg class="loureiro" viewBox="0 0 48 48" aria-hidden="true">
                      <path d="M24 40c-7-2-12-8-13-16M24 40c7-2 12-8 13-16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                      <g fill="currentColor">
                        <ellipse cx="10" cy="20" rx="2.6" ry="5" transform="rotate(-20 10 20)" />
                        <ellipse cx="12" cy="29" rx="2.6" ry="5" transform="rotate(-45 12 29)" />
                        <ellipse cx="17" cy="36" rx="2.6" ry="5" transform="rotate(-70 17 36)" />
                        <ellipse cx="38" cy="20" rx="2.6" ry="5" transform="rotate(20 38 20)" />
                        <ellipse cx="36" cy="29" rx="2.6" ry="5" transform="rotate(45 36 29)" />
                        <ellipse cx="31" cy="36" rx="2.6" ry="5" transform="rotate(70 31 36)" />
                      </g>
                      <circle cx="24" cy="21" r="6" fill="currentColor" opacity=".25" />
                    </svg>
                    <span>
                      <b>{p.ano}</b>
                      {p.texto}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    )
  }

  <div class="pe-escuro">
    <div class="contedor columnas">
      <div>
        <p class="nome"><img src={url('logo-feira.png')} alt="" width="40" height="36" />Feira da <em>Sostibilidade</em></p>
        {ax.pe.texto && <p>{ax.pe.texto}</p>}
      </div>
      <nav aria-label="Pé de páxina">
        <p class="etiqueta">Navegación</p>
        <ul>
          {nav.map((i) => <li><a href={url(i.href)}>{i.texto}</a></li>)}
        </ul>
      </nav>
      <div>
        <p class="etiqueta">Síguenos</p>
        <ul>
          {ax.instagram && <li><a href={ax.instagram} rel="noopener">Instagram {ax.instagramUsuario}</a></li>}
          {ax.correo && <li><a href={`mailto:${ax.correo}`}>{ax.correo}</a></li>}
          {ax.webIes && <li><a href={ax.webIes} rel="noopener">Web do IES Luís Seoane</a></li>}
        </ul>
      </div>
    </div>
    <div class="contedor legal">
      <p>Contidos baixo licenza <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.gl" rel="license noopener">CC BY-SA 4.0</a>, salvo indicación.</p>
      <ul>
        {legais.map((l) => <li><a href={url(l.href)}>{l.texto}</a></li>)}
      </ul>
    </div>
  </div>
</footer>

<style>
  .pe-claro { background: var(--crema); border-top: 1px solid var(--linha); padding-block: clamp(2.5rem, 5vw, 3.5rem); }
  .pe-claro .contedor { display: grid; gap: 2.5rem; }
  .grupos { display: flex; flex-wrap: wrap; gap: 2.2rem 4rem; align-items: flex-start; }
  .grupo { display: grid; gap: 0.9rem; }
  .grupo-titulo { font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--texto-suave); }
  .nota { font-family: var(--mono); font-size: 0.68rem; color: var(--texto-suave); }
  .premios { border-top: 1px solid var(--linha); padding-top: 1.8rem; display: grid; gap: 1rem; }
  .premios ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 1rem 2.5rem; }
  .premios li { display: flex; align-items: center; gap: 0.8rem; max-width: 34rem; color: var(--texto); font-size: 0.95rem; line-height: 1.35; }
  .premios b { display: block; font-family: var(--serif); font-size: 1.05rem; color: var(--verde-escuro); }
  .loureiro { width: 46px; height: 46px; flex: none; color: #b08a2e; }
  .pe-escuro { background: var(--negro); color: rgb(255 255 255 / 0.7); padding-block: 3rem 2rem; font-size: 0.95rem; }
  .pe-escuro a { color: rgb(255 255 255 / 0.85); }
  .pe-escuro a:hover { color: var(--verde-medio); }
  .etiqueta { color: var(--verde-medio); }
  .columnas { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 2rem; padding-bottom: 2.2rem; }
  .columnas ul { list-style: none; padding: 0; display: grid; gap: 0.4rem; }
  .nome { display: flex; align-items: center; gap: 0.6rem; font-family: var(--serif); font-size: 1.4rem; font-weight: 700; color: var(--branco); margin-bottom: 0.8rem; }
  .nome em { color: var(--verde-medio); }
  .legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; padding-top: 1.5rem; border-top: 1px solid rgb(255 255 255 / 0.1); font-size: 0.85rem; }
  .legal ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.4rem 1.4rem; }
  @media (max-width: 760px) {
    .columnas { grid-template-columns: 1fr; }
  }
</style>
