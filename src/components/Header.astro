---
import type { Edicion } from '../lib/esquemas';
import type { ItemNav } from '../lib/navegacion';
import { url } from '../lib/url';
import type { Marca } from '../lib/identidade';

interface Props {
  edicions: Edicion[];
  menu: ItemNav[];
  boton?: { href: string; texto: string };
  marca: Marca;
}

const { edicions, menu, boton, marca } = Astro.props;
// No despregable, a próxima edición leva un punto verde
const proxima = (href: string) => edicions.some((e) => e.estado === 'proxima' && href.replace(/\/?$/, '/') === `/edicions/${e.id}/`);
// Despregables con textos curtos (p. ex. anos) usan letra grande
const curtos = (i: ItemNav) => i.fillos.every((f) => f.texto.length <= 8);
const ruta = Astro.url.pathname.replace(/\/?$/, '/');
const interna = (href: string) => href.startsWith('/') && !href.startsWith('//');
const activa = (href: string) => interna(href) && (href === '/' ? ruta === '/' : ruta.startsWith(href.split(/[?#]/)[0]));
---

<header class="cabeceira">
  <div class="contedor barra">
    <a class="marca" href={url()}>
      <img src={marca.logo} alt="" width="44" height="40" />
      <span>{marca.antes} <em>{marca.destacado}</em></span>
    </a>

    <button class="menu-boton" type="button" aria-expanded="false" aria-controls="menu-principal">
      <span class="visualmente-oculto">Abrir menú</span>
      <span class="hamburguesa" aria-hidden="true"></span>
    </button>

    <nav id="menu-principal" class="menu" aria-label="Principal">
      <ul class="nivel1">
        {
          menu.map((item, n) =>
            item.fillos.length ? (
              <li class="con-submenu">
                <button type="button" class="submenu-boton" aria-expanded="false" aria-controls={`submenu-${n}`} aria-current={activa(item.href) || item.fillos.some((f) => activa(f.href)) ? 'page' : undefined}>
                  {item.texto}
                  <svg aria-hidden="true" width="10" height="10" viewBox="0 0 10 10"><path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
                </button>
                <ul id={`submenu-${n}`} class:list={['submenu', { 'submenu--texto': !curtos(item) }]}>
                  {item.fillos.map((f) => (
                    <li>
                      <a href={f.href} class:list={{ proxima: proxima(f.href) }} aria-current={activa(f.href) ? 'page' : undefined}>{f.texto}</a>
                    </li>
                  ))}
                  <li class="todas">
                    <a href={item.href}>{item.texto} →</a>
                  </li>
                </ul>
              </li>
            ) : (
              <li>
                <a href={item.href} aria-current={activa(item.href) ? 'page' : undefined}>
                  {item.texto}
                </a>
              </li>
            ),
          )
        }
      </ul>
      {boton && <a class="boton boton-cabeceira" href={boton.href}>{boton.texto}</a>}
    </nav>
  </div>
</header>

<script>
  const boton = document.querySelector<HTMLButtonElement>('.menu-boton');
  const menu = document.getElementById('menu-principal');
  boton?.addEventListener('click', () => {
    const aberto = boton.getAttribute('aria-expanded') === 'true';
    boton.setAttribute('aria-expanded', String(!aberto));
    menu?.classList.toggle('aberto', !aberto);
  });

  // Despregables (Edicións e páxinas con subpáxinas): clic/teclado (Escape pecha), e pechar ao premer fóra
  const subs = [...document.querySelectorAll<HTMLButtonElement>('.submenu-boton')];
  const pechar = (sub: HTMLButtonElement) => {
    sub.setAttribute('aria-expanded', 'false');
    sub.closest('li')?.classList.remove('aberto');
  };
  subs.forEach((sub) =>
    sub.addEventListener('click', (e) => {
      e.stopPropagation();
      const aberto = sub.getAttribute('aria-expanded') === 'true';
      subs.filter((x) => x !== sub).forEach(pechar);
      sub.setAttribute('aria-expanded', String(!aberto));
      sub.closest('li')?.classList.toggle('aberto', !aberto);
    }),
  );
  document.addEventListener('click', (e) => {
    subs.forEach((sub) => { if (!sub.closest('li')?.contains(e.target as Node)) pechar(sub); });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const aberto = subs.find((s) => s.getAttribute('aria-expanded') === 'true');
    if (aberto) {
      pechar(aberto);
      aberto.focus();
    }
  });
</script>

<style>
  .cabeceira {
    position: sticky; top: 0; z-index: 100;
    background: color-mix(in srgb, var(--negro) 97%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }
  .barra { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 68px; }
  .marca { display: flex; align-items: center; gap: 0.7rem; text-decoration: none; color: var(--branco); flex-shrink: 0; }
  .marca img { width: 40px; height: auto; }
  .marca span { font-family: var(--serif); font-weight: 700; font-size: 1.1rem; line-height: 1.1; }
  .marca em { color: var(--verde-medio); font-style: italic; }

  .menu { display: flex; align-items: center; gap: 1.6rem; }
  .nivel1 { display: flex; gap: 1.3rem; list-style: none; padding: 0; align-items: center; }
  .nivel1 > li > a, .submenu-boton {
    font: inherit; font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; text-decoration: none;
    color: rgb(255 255 255 / 0.72); padding-block: 0.4rem; border: 0; border-bottom: 2px solid transparent; background: none; cursor: pointer;
    display: inline-flex; align-items: center; gap: 0.4rem;
  }
  .nivel1 > li > a:hover, .submenu-boton:hover { color: var(--verde-medio); }
  .nivel1 > li > a[aria-current='page'], .submenu-boton[aria-current='page'] { color: var(--branco); border-bottom-color: var(--verde-medio); }
  .submenu-boton svg { transition: transform 0.2s; }
  .aberto > .submenu-boton svg { transform: rotate(180deg); }

  .con-submenu { position: relative; }
  .submenu {
    display: none; position: absolute; top: calc(100% + 0.9rem); left: 50%; transform: translateX(-50%);
    min-width: 170px; list-style: none; padding: 0.5rem; margin: 0;
    background: var(--branco); border-radius: var(--raio); box-shadow: 0 18px 40px rgb(0 0 0 / 0.28);
  }
  .submenu::before { content: ''; position: absolute; top: -6px; left: 50%; transform: translateX(-50%) rotate(45deg); width: 12px; height: 12px; background: var(--branco); }
  .aberto > .submenu { display: block; }
  .submenu a { display: flex; gap: 0.6rem; align-items: center; padding: 0.55rem 0.9rem; border-radius: var(--raio); text-decoration: none; color: var(--texto); font-family: var(--serif); font-weight: 700; font-size: 1.15rem; line-height: 1.2; }
  .submenu a.proxima::after { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--verde); margin-left: auto; }
  .submenu a:hover, .submenu a[aria-current='page'] { background: var(--verde-pale); color: var(--verde-escuro); }
  .submenu .todas { border-top: 1px solid var(--linha); margin-top: 0.35rem; padding-top: 0.35rem; }
  .submenu .todas a { font-family: var(--sans); font-weight: 600; font-size: 0.9rem; color: var(--verde); }
  .submenu--texto { min-width: 230px; }
  .boton-cabeceira { padding: 0.55rem 1.1rem; font-size: 0.8rem; }
  .submenu--texto a { font-size: 1rem; }

  .menu-boton { display: none; }

  @media (max-width: 920px) {
    .menu-boton {
      display: grid; place-items: center; width: 44px; height: 44px;
      background: none; border: 1px solid rgb(255 255 255 / 0.2); border-radius: var(--raio); cursor: pointer;
    }
    .hamburguesa, .hamburguesa::before, .hamburguesa::after {
      display: block; width: 20px; height: 2px; background: var(--branco); position: relative; transition: transform 0.2s;
    }
    .hamburguesa::before, .hamburguesa::after { content: ''; position: absolute; left: 0; }
    .hamburguesa::before { top: -6px; }
    .hamburguesa::after { top: 6px; }
    [aria-expanded='true'] .hamburguesa { background: transparent; }
    [aria-expanded='true'] .hamburguesa::before { transform: translateY(6px) rotate(45deg); }
    [aria-expanded='true'] .hamburguesa::after { transform: translateY(-6px) rotate(-45deg); }

    .menu {
      display: none; position: absolute; inset: 68px 0 auto 0; max-height: calc(100dvh - 68px); overflow-y: auto;
      flex-direction: column; align-items: stretch; gap: 1rem;
      background: var(--negro); padding: 1rem var(--marxe) 1.5rem;
      border-bottom: 1px solid rgb(255 255 255 / 0.1);
    }
    .menu.aberto { display: flex; }
    .nivel1 { flex-direction: column; gap: 0; align-items: stretch; }
    .nivel1 > li > a, .submenu-boton { display: flex; width: 100%; justify-content: space-between; padding-block: 0.9rem; font-size: 0.9rem; border-bottom: 1px solid rgb(255 255 255 / 0.08); }
    .nivel1 > li > a[aria-current='page'], .submenu-boton[aria-current='page'] { border-bottom-color: rgb(255 255 255 / 0.08); color: var(--verde-medio); }
    /* No móbil o despregable é un acordeón dentro do menú */
    .submenu { position: static; transform: none; box-shadow: none; min-width: 0; background: rgb(255 255 255 / 0.05); margin-block: 0.4rem; }
    .submenu::before { display: none; }
    .submenu a { color: rgb(255 255 255 / 0.85); }
    .submenu a:hover, .submenu a[aria-current='page'] { background: rgb(255 255 255 / 0.08); color: var(--verde-medio); }
    .submenu .todas { border-top-color: rgb(255 255 255 / 0.1); }
    .submenu .todas a { color: var(--verde-medio); }
  }
</style>
