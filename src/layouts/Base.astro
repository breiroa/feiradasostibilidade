---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { url } from '../lib/url';

interface Props {
  titulo?: string;
  descricion?: string;
  imaxe?: string;
}

const { titulo, descricion = site.descricion, imaxe } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${site.nome}` : `${site.nome} · ${site.lema}`;
const canonica = new URL(Astro.url.pathname, Astro.site);
const imaxeSocial = imaxe ? new URL(imaxe, Astro.site).href : undefined;
---

<!doctype html>
<html lang="gl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricion} />
    <link rel="canonical" href={canonica} />
    <link rel="icon" type="image/png" href={url('favicon.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content="gl_ES" />
    {imaxeSocial && <meta property="og:image" content={imaxeSocial} />}
    <meta name="theme-color" content="#1a1428" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300..700;1,9..40,400&family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Space+Mono&display=swap"
    />
  </head>
  <body>
    <a class="saltar" href="#contido">Saltar ao contido</a>
    <Header />
    <main id="contido">
      <slot />
    </main>
    <Footer />
  </body>
</html>
